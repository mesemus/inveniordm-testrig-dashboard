# Container-only overrides for the docker-compose `app` profile. Copy to `.env.compose`
# (git-ignored); compose loads it after `.env`, so only what differs *inside* the compose
# network belongs here. Everything else (the GitHub/OAuth secrets, webhooks) stays in `.env`.
#
# Inside the network the services answer on their container names and standard ports; from the
# host the same services are at localhost:25432 (Postgres) and localhost:29000 (S3).

ITD_DATABASE_URL=postgresql://invenio_testrig_dashboard:invenio_testrig_dashboard@postgres:5432/invenio_testrig_dashboard

# The app reaches RustFS as s3:9000. Browsers cannot: artifact links are presigned against the
# published host port (it must be a different origin than public_url: artifacts include HTML/SVG).
ITD_S3_ENDPOINT_URL=http://s3:9000
ITD_S3_PUBLIC_ENDPOINT_URL=http://localhost:29000

# Local container testing without a GitHub OAuth app: every page is readable anonymously and the
# auth endpoints answer 404. NEVER set this in a real deployment. (The Helm chart refuses
# config.require_login: false and has no way to inject extra env variables.) To test the login in compose, put the three
# OAuth variables from .env.example into .env instead, register
# http://localhost:8000/api/auth/callback in the OAuth app, and delete the line below.
ITD_REQUIRE_LOGIN=false
