# Secrets for local development. Copy to .env (git-ignored).
# Non-secret settings live in config.yaml (see config.example.yaml).
# ITD_CONFIG_FILE must be set as a real environment variable: it is read before .env is loaded.
# Running the docker-compose `app` profile? Also copy .env.compose.example to .env.compose;
# it overrides only the addresses that differ inside the compose network (see README).

# Postgres from docker-compose.
ITD_DATABASE_URL=postgresql://invenio_testrig_dashboard:invenio_testrig_dashboard@localhost:25432/invenio_testrig_dashboard

# Fake GitHub token. Replace with a fine-grained PAT that has actions: read/write,
# contents: read/write (testrig may update the runner repo's workflow file) and
# metadata: read on the runner repository to dispatch runs.
ITD_GITHUB_TOKEN=ghp_fake0000000000000000000000000000000000

# RustFS credentials from docker-compose.
ITD_S3_ACCESS_KEY=devaccess
ITD_S3_SECRET_KEY=devsecret

# Optional: Discord alerts are only logged when these are unset.
# ITD_DISCORD_WEBHOOK_URL=
# ITD_DISCORD_OPS_WEBHOOK_URL=

# GitHub OAuth login: required, because every page needs a login (see README).
# ITD_GITHUB_OAUTH_CLIENT_ID=
# ITD_GITHUB_OAUTH_CLIENT_SECRET=
# ITD_SESSION_SECRET=
# Local development without an OAuth app only (never in production):
# ITD_REQUIRE_LOGIN=false
